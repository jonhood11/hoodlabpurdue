---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<footer class="site-footer">
  <div class="footer-inner">
    <img
      src={withBase("/media/purdue-sig-black-gold.png")}
      width="3000"
      height="896"
      alt="Purdue University"
    />
    <address>
      <span>Purdue University</span>
      <a href="https://www.chem.purdue.edu/">Chemistry Department</a>
      <a href="https://www.physics.purdue.edu/">Physics and Astronomy Department</a>
      <span>360 Oval Drive</span>
      <span>West Lafayette, IN 47907</span>
    </address>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: clamp(4.5rem, 9vw, 7rem);
    padding: 2.6rem 1rem 3.2rem;
  }

  .footer-inner {
    align-items: center;
    display: flex;
    gap: 3rem;
    justify-content: center;
    margin: 0 auto;
    max-width: 760px;
  }

  img {
    height: auto;
    width: 180px;
  }

  address {
    color: var(--muted);
    display: flex;
    flex-direction: column;
    font-size: 0.84rem;
    font-style: normal;
    gap: 0.1rem;
    line-height: 1.5;
  }

  address a {
    color: var(--muted);
  }

  address a:hover {
    color: var(--gold);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: 1.6rem;
      text-align: center;
    }

    address {
      align-items: center;
    }

    img {
      width: 150px;
    }
  }
</style>
