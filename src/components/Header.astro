---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const navigation = [
  { href: "/", label: "Home" },
  { href: "/research", label: "Research" },
  { href: "/blog", label: "News" },
  { href: "/team", label: "Team" },
  { href: "/publications", label: "Publications" },
  { href: "/theses", label: "Theses" },
];

function isCurrent(href: string) {
  if (href === "/") return currentPath === "/";
  if (href === "/blog") return currentPath === "/blog" || currentPath.startsWith("/post/");
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="band">
  <a class="brand" href={withBase("/")} aria-label="Hood Lab home">
    <img
      src={withBase("/media/dfd400_81ee0a0d44ad4b99bea692a931e99990~mv2.png")}
      width="1749"
      height="430"
      alt="Hood Lab"
    />
    <span>Quantum Optics Lab @ Purdue</span>
  </a>
  <nav aria-label="Primary navigation">
    <ul>
      {navigation.map((item) => (
        <li>
          <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .band {
    background: var(--band);
    color: #f2f0ee;
    padding: 1.4rem 24px 0;
    text-align: center;
  }

  .brand {
    display: inline-block;
    text-decoration: none;
  }

  .brand:hover {
    color: inherit;
  }

  .brand img {
    height: auto;
    margin-inline: auto;
    width: min(340px, 70vw);
  }

  .brand span {
    color: #cfccc7;
    display: block;
    font-size: 0.76rem;
    letter-spacing: 0.24em;
    margin-top: 0.35rem;
    text-transform: uppercase;
  }

  nav {
    margin-top: 0.9rem;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 3vw, 2.2rem);
    justify-content: center;
    list-style: none;
    margin: 0 auto;
    padding: 0 0 0.9rem;
  }

  nav a {
    border-bottom: 2px solid transparent;
    color: #b9b5af;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    padding-block: 0.3rem;
    text-decoration: none;
  }

  nav a:hover {
    color: #ffffff;
  }

  nav a[aria-current="page"] {
    border-bottom-color: #ffffff;
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .band {
      padding-top: 1rem;
    }

    .brand img {
      width: min(280px, 78vw);
    }

    nav ul {
      gap: 0.4rem 1.1rem;
      row-gap: 0.15rem;
    }
  }
</style>
