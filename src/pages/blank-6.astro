---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "open-positions");
if (!page) throw new Error("Missing open positions content");
const { Content } = await render(page);
---

<BaseLayout title="Open Positions | Hood Lab" description={page.data.description}>
  <h1 class="page-heading">Open Positions</h1>
  <article class="content-panel prose positions"><Content /></article>
</BaseLayout>

<style>
  .positions { font-size: 1.2rem; margin-inline: auto; max-width: 760px; text-align: center; }
</style>
