---
import BaseLayout from "../layouts/BaseLayout.astro";
import { AREAS, papersFor } from "../data/research";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<BaseLayout title="Research | Hood Lab" description="Quantum optics research in ultracold molecules, organic quantum emitters, colloidal quantum dots, and theory at Purdue University.">
  <h1 class="page-heading">Research</h1>

  {AREAS.map((a) => (
    <article class="area" id={a.key}>
      <h2>{a.title}{a.draft && <span class="draft">draft copy</span>}</h2>
      {a.short && <p class="short">{a.short}</p>}
      <div class:list={["cols", { "no-figs": a.images.length === 0 }]}>
        <div class="txt">
          {a.paragraphs.length > 0 ? (
            a.paragraphs.map((p) => <p class="prose-p">{p}</p>)
          ) : (
            <p class="placeholder">Text to be added.</p>
          )}
        </div>
        {a.images.length > 0 && (
          <div class="figs">
            {a.images.map((img) => (
              <img src={withBase(img)} alt={a.alt} loading="lazy" />
            ))}
          </div>
        )}
      </div>
      <aside class="papers-bin" aria-label={`Papers: ${a.title}`}>
        <h3>Papers</h3>
        {papersFor(a.key).length > 0 ? (
          <ul>
            {papersFor(a.key).map((pub) => (
              <li>
                <a class="pt" href={pub.venue?.href ?? pub.arxiv}>{pub.title}</a>
                <span class="meta">
                  <span class="py">{pub.year}</span>
                  {pub.venue?.href && <a class="pl" href={pub.venue.href}>Journal</a>}
                  {pub.arxiv && <a class="pl" href={pub.arxiv}>arXiv</a>}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="soon">First paper on its way.</p>
        )}
      </aside>
    </article>
  ))}
</BaseLayout>

<style>
  .area {
    border-bottom: 1px solid var(--line);
    padding: clamp(1.8rem, 4vw, 2.6rem) 0 clamp(2rem, 4.5vw, 2.8rem);
    scroll-margin-top: 1rem;
  }

  .area:last-of-type {
    border-bottom: 0;
  }

  .area h2 {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    font-size: 1.4rem;
    font-weight: 600;
    gap: 0.9rem;
    margin: 0 0 0.2rem;
  }

  .draft {
    border: 1.5px solid #cfb991;
    border-radius: 999px;
    color: var(--gold);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    padding: 0.06rem 0.55rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .short {
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    margin: 0 0 1.1rem;
    text-transform: uppercase;
  }

  .cols {
    align-items: start;
    display: grid;
    gap: clamp(1.6rem, 4vw, 3rem);
    grid-template-columns: 1fr minmax(280px, 40%);
  }

  .cols.no-figs {
    grid-template-columns: 1fr;
  }

  .placeholder {
    border: 1.5px dashed #cfb991;
    border-radius: 8px;
    color: var(--gold);
    display: inline-block;
    font-style: italic;
    margin: 0;
    padding: 0.3rem 0.9rem;
  }

  .prose-p {
    font-size: 0.99rem;
    margin: 0 0 1.1rem;
  }

  .prose-p:last-child {
    margin-bottom: 0;
  }

  .figs {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .figs img {
    border: 1px solid var(--line);
    border-radius: 12px;
    height: auto;
    width: 100%;
  }

  .papers-bin {
    background: #faf9f6;
    border: 1px solid var(--line);
    border-radius: 14px;
    margin-top: clamp(1.4rem, 3vw, 2rem);
    padding: 1.2rem 1.4rem 1rem;
  }

  .papers-bin h3 {
    border-bottom: 2px solid var(--band);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    margin: 0 0 0.4rem;
    padding-bottom: 0.4rem;
    text-transform: uppercase;
  }

  .papers-bin ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .papers-bin li {
    align-items: baseline;
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
    padding: 0.6rem 0.05rem;
  }

  .papers-bin li:last-child {
    border-bottom: 0;
  }

  .pt {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.4;
    min-width: 240px;
    text-decoration: none;
  }

  .pt:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .meta {
    align-items: baseline;
    display: flex;
    gap: 1rem;
  }

  .py {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .pl {
    color: var(--gold);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .pl:hover {
    text-decoration: underline;
  }

  .soon {
    color: var(--muted);
    font-size: 0.92rem;
    font-style: italic;
    margin: 0.4rem 0 0;
  }

  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr;
    }

    .figs {
      order: -1;
    }
  }
</style>
