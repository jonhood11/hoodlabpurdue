---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "theses");
if (!page) throw new Error("Missing theses content");
const { Content } = await render(page);
---

<BaseLayout title="Theses | Hood Lab" description={page.data.description}>
  <h1 class="page-heading">Theses</h1>
  <article class="content-panel prose theses"><Content /></article>
</BaseLayout>

<style>
  .theses { text-align: center; }
  .theses :global(img) { max-height: 420px; object-fit: contain; }
  .theses :global(h1) { font-size: 1.4rem; }
</style>
