---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsTimeline from "../../components/NewsTimeline.astro";

const posts = (await getCollection("news")).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
---

<BaseLayout title="News | Hood Lab" description="News and milestones from the Hood Lab at Purdue.">
  <h1 class="page-heading">All Posts</h1>
  <section aria-label="News posts">
    <NewsTimeline posts={posts} />
  </section>
</BaseLayout>
