---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "links");
if (!page) throw new Error("Missing links content");
const { Content } = await render(page);
---

<BaseLayout title="Links | Hood Lab" description={page.data.description}>
  <h1 class="page-heading">Links</h1>
  <article class="content-panel prose"><Content /></article>
</BaseLayout>
