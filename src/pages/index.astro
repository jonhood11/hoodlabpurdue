---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsTimeline from "../components/NewsTimeline.astro";

const posts = (await getCollection("news"))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 10);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<BaseLayout>
  <section class="hero">
    <figure class="hero-photo">
      <img
        src={withBase("/media/dfd400_7f9e3261a6ab4336abf54efaa67cf60f~mv2.jpg")}
        width="4080"
        height="3072"
        alt="Members of the Hood Lab at a group bowling outing"
      />
    </figure>
    <h1>Welcome to the Hood Lab at Purdue!</h1>
    <p class="lede placeholder">Text to be added.</p>
  </section>

  <section class="news">
    <h2>News Feed</h2>
    <NewsTimeline posts={posts} />
    <p class="all-news"><a href={withBase("/blog")}>All news &rarr;</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(2rem, 5vw, 3rem);
  }

  .hero-photo {
    margin: 0 0 clamp(1.8rem, 4vw, 2.4rem);
  }

  .hero-photo img {
    aspect-ratio: 21 / 10;
    border-radius: 12px;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  h1 {
    margin-bottom: 1rem;
  }

  .lede {
    color: var(--muted);
    font-size: 1.01rem;
    margin: 0;
  }

  .placeholder {
    border: 1.5px dashed #cfb991;
    border-radius: 8px;
    color: var(--gold);
    display: inline-block;
    font-style: italic;
    padding: 0.3rem 0.9rem;
  }

  .news {
    padding-top: clamp(2.6rem, 5vw, 3.8rem);
  }

  .news h2 {
    border-bottom: 3px solid var(--band);
    font-size: 1.5rem;
    margin: 0 0 1.5rem;
    padding-bottom: 0.55rem;
  }

  .all-news {
    margin: 1.6rem 0 0;
    text-align: right;
  }

  .all-news a {
    color: var(--gold);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .all-news a:hover {
    text-decoration: underline;
  }
</style>
