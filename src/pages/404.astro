---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const links = [
  { href: "/", label: "Home" },
  { href: "/research", label: "Research" },
  { href: "/blog", label: "News" },
  { href: "/team", label: "Team" },
  { href: "/publications", label: "Publications" },
  { href: "/theses", label: "Theses" },
];
---

<BaseLayout title="Page not found | Hood Lab" description="That page does not exist on the Hood Lab site.">
  <h1 class="page-heading">Page not found</h1>
  <p class="lede">
    That page does not exist, or it has moved. Try one of these instead:
  </p>
  <ul class="links">
    {links.map((l) => (
      <li><a href={withBase(l.href)}>{l.label}</a></li>
    ))}
  </ul>
</BaseLayout>

<style>
  .lede {
    color: var(--muted);
    margin: 0 0 1.4rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
  }

  .links a {
    color: var(--gold);
    font-weight: 500;
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
