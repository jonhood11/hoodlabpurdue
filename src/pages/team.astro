---
import BaseLayout from "../layouts/BaseLayout.astro";
import { current, previousGrad, previousUndergrad } from "../data/team";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const media = (filename: string) => `${base}media/${filename}`;

// The first group's heading is visually hidden: the "Team" h1 already labels it,
// but keeping the heading preserves h1 > h2 > h3 order for screen readers.
// Current members have short titles ("PI", "Graduate Student"), which suit the
// gold kicker above the name. Former members' roles are sentences about where
// they went, so they read as a note under the name instead.
const groups = [
  { title: "Current members", hidden: true, kicker: true, people: current },
  { title: "Previous Graduate Students & Postdocs", hidden: false, kicker: false, people: previousGrad },
  { title: "Former Undergraduates", hidden: false, kicker: false, people: previousUndergrad },
];
---

<BaseLayout title="Team | Hood Lab" description="Current and former members of the Hood Lab at Purdue University.">
  <h1 class="page-heading">Team</h1>

  {groups.map((group) => (
    <section aria-label={group.title}>
      <h2 class:list={[group.hidden ? "sr-only" : "section-heading"]}>{group.title}</h2>
      <div class="people-grid">
        {group.people.map((person) => (
          <article class="person">
            <img src={media(person.image)} alt={`Portrait of ${person.name}`} loading="lazy" />
            {group.kicker && <p class="role">{person.role}</p>}
            <h3>{person.scholar ? <a href={person.scholar}>{person.name}</a> : person.name}</h3>
            {!group.kicker && <p class="note">{person.role}</p>}
            {person.email && (
              <a class="email" href={`mailto:${person.email}`}>{person.email}</a>
            )}
            {person.extra && <a class="email" href={person.extra.href}>{person.extra.label}</a>}
          </article>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .people-grid {
    display: grid;
    gap: 2.4rem 1.6rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .person {
    text-align: center;
  }

  .person img {
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 50%;
    height: auto;
    margin: 0 auto 0.9rem;
    object-fit: cover;
    transition: border-color 160ms ease, transform 160ms ease;
    width: min(100%, 160px);
  }

  .person:hover img {
    border-color: var(--gold);
    transform: translateY(-3px);
  }

  .role {
    color: var(--gold);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    margin: 0 0 0.15rem;
    text-transform: uppercase;
  }

  .person h3 {
    font-size: 1.02rem;
    font-weight: 600;
    margin: 0 0 0.2rem;
  }

  .person h3 a {
    text-decoration: none;
  }

  .person h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .note {
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.45;
    margin: 0 0 0.2rem;
  }

  .email {
    color: var(--muted);
    display: block;
    font-size: 0.78rem;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .email:hover {
    color: var(--gold);
  }

  .section-heading {
    border-bottom: 3px solid var(--band);
    font-size: 1.4rem;
    margin: 3.4rem 0 1.8rem;
    padding-bottom: 0.5rem;
  }

  @media (max-width: 860px) {
    .people-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .people-grid {
      gap: 2rem 1.2rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
